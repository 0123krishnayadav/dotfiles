# Ghostty config. ~/.config/ghostty is linked to this folder, so edits here are live.
#   Reload:     Cmd+Shift+,   (window size only applies to new windows)
#   Check:      ghostty +validate-config
#   All options: ghostty +show-config --default --docs

# Font: Menlo (built into macOS). Ghostty draws Nerd Font icons from its own bundled
# copy, so Neovim, lazygit and the prompt keep their icons without a patched font.
font-family = Menlo
font-size = 14

# Launching Ghostty opens one maximized window running herdr. Cmd+T/Q/D/Shift+D
# and Cmd+1..9 control Herdr tabs/splits; Cmd+N opens a plain shell window.
# Closing the herdr window (or detaching with
# Option+Space q) quits Ghostty, so the next launch opens herdr again; the herdr
# session itself keeps running in the background. Run through a login zsh so
# herdr gets the Homebrew PATH from .zprofile (apps opened from the Dock don't).
initial-command = /bin/zsh -lc 'exec herdr'
quit-after-last-window-closed = true
# Don't let macOS window restore replace the herdr window; herdr restores its own sessions
window-save-state = never
# Maximized (fills the screen, keeps the menu bar and Dock), not macOS fullscreen
maximize = true

# Windows open in ~ (110x30 when not maximized). New tabs and splits open in the current folder
window-width = 110
window-height = 30
window-inherit-working-directory = false

cursor-style-blink = false
# Don't dim the inactive split
unfocused-split-opacity = 1

# Both Option keys act as Alt, so herdr's alt chords and zsh's Alt keys work.
# Typing Mac special characters with Option (é, £) is given up on purpose.
macos-option-as-alt = true

# Over ssh, send TERM=xterm-256color (servers don't know xterm-ghostty)
shell-integration-features = ssh-env

# macOS-style Cmd keys, sent as CSI u escape sequences so Neovim reads them as <D-...>
# (nvim/init.lua) and zsh can bind them (zsh/keybindings.zsh). At the zsh prompt,
# Cmd+F / Cmd+Shift+F still open / close Ghostty's find bar (zsh asks Ghostty to).
# Cmd+-/= no longer change the font size; use the menu bar for that.
keybind = super+p=csi:112;9u
keybind = super+f=csi:102;9u
keybind = super+shift+f=csi:102;10u
keybind = super+s=csi:115;9u
keybind = super+minus=csi:45;9u
keybind = super+equal=csi:61;9u
keybind = super+backspace=csi:127;9u
keybind = super+arrow_left=csi:1;9D
keybind = super+arrow_right=csi:1;9C

# Forward tab/split shortcuts to Herdr. Cmd+Q closes the current Herdr tab.
# Cmd+1..9 selects the corresponding Herdr tab in the current workspace. These use the
# physical-key names (digit_N): Ghostty's defaults bind super+digit_N to goto_tab, and
# physical-key bindings win over super+1 / super+one, which would never fire.
keybind = super+t=csi:116;9u
keybind = super+q=csi:113;9u
keybind = super+d=csi:100;9u
keybind = super+shift+d=csi:100;10u
keybind = super+digit_1=csi:49;9u
keybind = super+digit_2=csi:50;9u
keybind = super+digit_3=csi:51;9u
keybind = super+digit_4=csi:52;9u
keybind = super+digit_5=csi:53;9u
keybind = super+digit_6=csi:54;9u
keybind = super+digit_7=csi:55;9u
keybind = super+digit_8=csi:56;9u
keybind = super+digit_9=csi:57;9u

# Option+fn+Delete deletes the next word. Option+←/→ (word jumps) and
# Option+Delete (previous word) already work by default.
keybind = alt+delete=esc:d
