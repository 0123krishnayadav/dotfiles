{
  "Stop": [
    { "hooks": [{ "type": "command", "command": "(afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1 &)" }] }
  ],
  "PermissionRequest": [
    { "matcher": "*", "hooks": [{ "type": "command", "command": "(afplay /System/Library/Sounds/Ping.aiff >/dev/null 2>&1 &)" }] }
  ],
  "Notification": [
    { "matcher": "idle_prompt|elicitation_dialog", "hooks": [{ "type": "command", "command": "(afplay /System/Library/Sounds/Ping.aiff >/dev/null 2>&1 &)" }] }
  ]
}
