[init]
	defaultBranch = main
[core]
	pager = delta
[alias]
	cb = branch --show-current
[interactive]
	diffFilter = delta --color-only
[delta]
	# Pretty side-by-side `git diff` / `git log -p` / `git show`. One column: `git -c delta.side-by-side=false diff`
	# (lazygit ignores this section: it gives delta theme/delta.gitconfig with --config instead)
	line-numbers = true
	side-by-side = true
[include]
	path = ~/.gitconfig.local
