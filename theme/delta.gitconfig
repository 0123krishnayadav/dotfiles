# Generated by build.lua from palette.lua: change those, then run nvim -l ~/.config/theme/build.lua
[delta]
	syntax-theme = dark2026
	dark = true
	minus-style = syntax "#2d1919"
	minus-emph-style = syntax "#693331"
	plus-style = syntax "#17231a"
	plus-emph-style = syntax "#2a4c2d"
	line-numbers-zero-style = "#858889"
	line-numbers-minus-style = "#F28772"
	line-numbers-plus-style = "#72C892"
	line-numbers-left-style = "#333536"
	line-numbers-right-style = "#333536"
	file-style = "#48A0C7"
	file-decoration-style = "#48A0C7 ul"
	hunk-header-decoration-style = "#333536 box"
