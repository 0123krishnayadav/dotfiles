# Install everything with:  brew bundle --file=Brewfile

# CLI tools
brew "fnm"                  # Node version manager
brew "fzf"                  # fuzzy finder (Ctrl+R history, Ctrl+T files)
brew "zoxide"               # smarter cd
brew "bun"
brew "colima"               # Docker runtime (no Docker Desktop)
brew "docker"
brew "docker-buildx"
brew "mas"                  # Mac App Store CLI
brew "neovim"               # editor (config: nvim, kickstart.nvim)
brew "tree-sitter-cli"      # builds Neovim syntax parsers
brew "fd"                   # better find
brew "ripgrep"              # better grep (grep alias)
brew "bat"                  # better cat  (cat alias)
brew "lazygit"              # git UI in the terminal (run `lazygit` in a repo)
brew "git-delta"            # nicer diffs: side by side in git diff and lazygit

# Fonts
cask "font-jetbrains-mono-nerd-font" # icons in Neovim (used by the iTerm2 profile)

# Apps
cask "iterm2"
cask "brave-browser"
cask "raycast"               # launcher, app hotkeys, window snapping
cask "karabiner-elements"    # Caps Lock / Right Cmd = Hyper key
cask "visual-studio-code"
cask "bitwarden"
cask "appcleaner"

# Mac App Store (must be signed in to the App Store first)
mas "Amphetamine", id: 937984704

# VS Code extensions
vscode "anthropic.claude-code"
vscode "pkief.material-icon-theme"
vscode "rust-lang.rust-analyzer"
