# What the configs in this repo need. setup.sh installs it (brew bundle). Extras: optional/

# CLI tools
brew "fzf"                  # fuzzy finder (Ctrl+R history, Ctrl+T files)
brew "zoxide"               # smarter cd
brew "neovim"               # editor (config: nvim, LazyVim)
brew "tree-sitter-cli"      # builds Neovim syntax parsers
brew "fd"                   # better find
brew "ripgrep"              # better grep: rg (Neovim search uses it too)
brew "bat"                  # better cat (cat alias)
brew "lazygit"              # git UI in the terminal (run `lazygit` in a repo)
brew "git-delta"            # nicer diffs: side by side in git diff and lazygit
brew "oh-my-posh"           # prompt (theme set in zsh/prompt.zsh). Homebrew's own, not Oh My Posh's tap
brew "jq"                   # JSON for setup.sh and the Claude Code status line (macOS 15+ also has /usr/bin/jq)

# Fonts
cask "font-jetbrains-mono-nerd-font" # font with icons for VS Code and Ghostty (vscode/settings.json, ghostty/)

# Apps
cask "herdr-app"             # terminal: herdr as a desktop app (config: herdr-app/)
cask "ghostty"               # second terminal (config: ghostty/)
cask "raycast"               # launcher, app hotkeys
cask "karabiner-elements"    # Caps Lock / Right Cmd = Hyper key
cask "visual-studio-code"
